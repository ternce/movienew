FROM node:20-alpine

WORKDIR /app

# Сначала копируем только package-файлы,
# чтобы слой npm install нормально кэшировался.
COPY package.json package-lock.json ./
COPY apps/web/package*.json ./apps/web/
COPY packages/shared/package*.json ./packages/shared/
COPY packages/typescript-config/package*.json ./packages/typescript-config/

# Устанавливаем зависимости всего monorepo.
RUN npm install

# Копируем исходники проекта.
COPY . .

# Собираем shared-пакет, который используется web-приложением.
RUN npm run build --workspace=@movie-platform/shared

WORKDIR /app/apps/web

ENV NODE_ENV=development
ENV NEXT_TELEMETRY_DISABLED=1
ENV HOSTNAME=0.0.0.0
ENV PORT=3000

EXPOSE 3000

CMD ["npm", "run", "dev"]